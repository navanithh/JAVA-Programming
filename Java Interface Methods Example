interface I1
{
    default void m1() {
        System.out.println("m1 method");
    }
    static void m2(){
        System.out.println("m2 method");
    }
    void m3();
}

public class Student implements I1
{
    public void m3(){
        System.out.println("m3 method");
    }
    public static void main(String args[]){
        Student s1=new Student();
        s1.m1();
        I1.m2();
        s1.m3();
    }
}
