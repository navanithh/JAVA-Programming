public class Employee
{
    int eno;
    String ename;
    Employee(){
        eno=10;
        ename="Bheem";
        System.out.println("default constructor....");
    }
    void display()
    {
        System.out.println(eno+" "+ename);
    }
    public static void main(String args[]){
        Employee ob=new Employee();
        ob.display();
    }
}  
